# Copy to .env and fill in. NEVER commit .env.

APP_ENV=development            # development | test | production

# --- Supabase PostgreSQL --------------------------------------------------
# Use the SESSION POOLER connection string (IPv4 compatible, works from WSL2):
#   Supabase dashboard -> Connect -> Session pooler
# Replace the "postgresql://" prefix with "postgresql+psycopg://".
# Example shape (placeholders, not real values):
#   postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# Optional: separate database for tests. Tests refuse to run against DATABASE_URL.
TEST_DATABASE_URL=

# --- Backend ---------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000
# Optional shared secret. If set, every API call must send header X-API-Key.
API_KEY=

# --- Frontend --------------------------------------------------------------
API_BASE_URL=http://127.0.0.1:8000

# --- Resume handling -------------------------------------------------------
RESUME_DIR=data/resumes
MAX_UPLOAD_MB=5

# --- AI matching -----------------------------------------------------------
# auto = try sentence-transformers, fall back to the lightweight hashing embedder
EMBEDDING_BACKEND=auto         # auto | sentence-transformers | hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Scoring weights (normalised automatically; see docs/07-ai-and-semantic-matching.md)
WEIGHT_SKILLS=0.30
WEIGHT_SEMANTIC=0.30
WEIGHT_TITLE=0.15
WEIGHT_EXPERIENCE=0.10
WEIGHT_KEYWORDS=0.15

# --- Collectors ------------------------------------------------------------
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
HTTP_MIN_INTERVAL_SECONDS=0.5  # polite delay between requests to the same host

# --- Scheduler (optional) --------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_HOURS=12

# --- Email notifications (optional) ----------------------------------------
# Use an app password / SMTP credential from your provider, NOT your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
